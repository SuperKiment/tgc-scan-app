<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Pre-Compose window theme only: colours and typography come from TcgScanTheme. No AppCompat
      dependency, so the parent is the platform Material theme available since API 26.
    -->
    <style name="Theme.TcgScan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
