<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      AC-3 / NFR-5: CAMERA, INTERNET and ACCESS_NETWORK_STATE are the only user-facing permissions.
      androidx.core additionally contributes the app-private signature permission
      org.tcgscan.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION, which must stay.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".TcgScanApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:fullBackupContent="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.TcgScan">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|uiMode|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TcgScan"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          D5 / NFR-5: onnxruntime-android ships a telemetry initializer provider. The permissions it
          declares are the ones we already allow, but the provider itself must never be merged in.
        -->
        <provider
            android:name="ai.onnxruntime.TelemetryInitializer"
            android:authorities="${applicationId}.onnxruntime_telemetry_initializer"
            tools:node="remove" />
    </application>

</manifest>
