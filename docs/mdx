#!/usr/bin/env bash
# Usage : ./mdx fichier.md        -> affiche l'index (lignes 1 à N, N = ligne 1 du fichier)
#         ./mdx fichier.md A B    -> affiche les lignes A à B
set -euo pipefail

f=$1
if [[ $# -eq 1 ]]; then
  n=$(head -n1 "$f")
  [[ $n =~ ^[0-9]+$ ]] || { echo "Pas d'index dans $f" >&2; exit 1; }
  head -n "$n" "$f"
else
  sed -n "${2},${3}p" "$f"
fi
